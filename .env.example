# =============================================================================
# AgentAssistBench — environment configuration
# Copy this file to .env and fill in your values.
# All variables use the BENCH_ prefix.
# Explicit environment variables always take precedence over .env values.
# =============================================================================

# -----------------------------------------------------------------------------
# API / Server
# -----------------------------------------------------------------------------
BENCH_HOST=127.0.0.1
BENCH_PORT=8000

# -----------------------------------------------------------------------------
# Runner
# -----------------------------------------------------------------------------
# Seconds to wait between agent executions (0 = no delay)
BENCH_DELAY_SECONDS=2.0
# Hard timeout per agent execution in seconds
BENCH_TIMEOUT_SECONDS=300.0

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
BENCH_DB_PATH=storage/benchmark.db
BENCH_EXPORT_DIR=storage/exports

# -----------------------------------------------------------------------------
# Agent endpoints
# Accepted formats: local Docker, VM address, or managed-container URL
# -----------------------------------------------------------------------------
BENCH_HERMES_ENDPOINT=http://localhost:8001/v1
BENCH_OPENCLAW_ENDPOINT=http://localhost:8002/v1

# -----------------------------------------------------------------------------
# Agent deployment types
# Valid values: local_docker | virtual_machine | managed_container
# -----------------------------------------------------------------------------
BENCH_HERMES_DEPLOYMENT_TYPE=local_docker
BENCH_OPENCLAW_DEPLOYMENT_TYPE=local_docker

# -----------------------------------------------------------------------------
# Agent deployment resource config (optional — used for cost/metrics tracking)
# -----------------------------------------------------------------------------
# BENCH_HERMES_CPU_CORES=4
# BENCH_HERMES_MEMORY_MB=8192
# BENCH_HERMES_COST_PER_HOUR=0.45
# BENCH_OPENCLAW_CPU_CORES=2
# BENCH_OPENCLAW_MEMORY_MB=4096
# BENCH_OPENCLAW_COST_PER_HOUR=0.25

# -----------------------------------------------------------------------------
# Agent API keys  (required — never commit real values)
# -----------------------------------------------------------------------------
BENCH_HERMES_API_KEY=your-hermes-api-key-here
BENCH_OPENCLAW_API_KEY=your-openclaw-api-key-here

# NVIDIA API key — only needed for optional nemotron agents; leave empty otherwise
# BENCH_NVIDIA_API_KEY=

# -----------------------------------------------------------------------------
# Generic agents  (optional — define any number of OpenAI-compatible agents)
# Use this instead of, or alongside, the Hermes/OpenClaw settings above.
# Each item needs: name (str), endpoint (str), model (str)
# Optional per item: api_key, deployment_type, cpu_cores, memory_mb, cost_per_hour
#
# Single agent:
# BENCH_AGENTS_JSON=[{"name":"librechat","endpoint":"http://localhost:9000/v1","model":"gpt-4o","api_key":"sk-..."}]
#
# Multiple agents (use \n-free single line):
# BENCH_AGENTS_JSON=[{"name":"ollama-llama3","endpoint":"http://localhost:11434/v1","model":"llama3"},{"name":"openwebui","endpoint":"http://localhost:3000/v1","model":"mistral","api_key":"sk-...","deployment_type":"local_docker","cpu_cores":4,"cost_per_hour":0.20}]
# -----------------------------------------------------------------------------
BENCH_AGENTS_JSON=

# -----------------------------------------------------------------------------
# Request signing key
# Shared HMAC-SHA256 secret between the benchmark runner and agents.
# Leave empty to disable request signing.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
BENCH_SIGNING_KEY=your-signing-key-here

# -----------------------------------------------------------------------------
# Connector bot tokens  (leave empty to disable the connector)
# Telegram token:  obtain from @BotFather → /newbot
# Discord token:   https://discord.com/developers/applications → Bot → Token
# -----------------------------------------------------------------------------
BENCH_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
BENCH_DISCORD_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to trigger benchmarks.
# Leave empty to accept all chats (not recommended for public bots).
# How to find your chat ID: message @userinfobot in Telegram — it replies with your ID.
# Example: BENCH_TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Multiple: BENCH_TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
BENCH_TELEGRAM_ALLOWED_CHAT_IDS=

# -----------------------------------------------------------------------------
# Logging
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------
BENCH_LOG_LEVEL=INFO
