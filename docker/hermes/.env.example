# Hermes agent container configuration — copy to .env and fill in.
#
# NOTE: hermes-agent does NOT expand ${VAR} placeholders in config.yaml.
# The model backend is configured in ./data/config.yaml (literal values);
# this file carries the API server settings.

# LLM backend (informational defaults; the effective values live in
# ./data/config.yaml -> model.base_url / model.api_key)
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=nvapi-xxxx

# OpenAI-compatible API server (what the benchmark runner talks to)
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# Bearer token the benchmark runner must send — set the same value in the
# root .env as BENCH_HERMES_API_KEY
API_SERVER_KEY=change-me
