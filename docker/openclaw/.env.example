# ============================================================
# OpenClaw Agent — Environment Variables
# ============================================================
# cp .env.example .env  then fill in MODEL_API_KEY

# --- LLM Backend (NVIDIA Nemotron-120B) ---
MODEL_NAME=nvidia/llama-3.1-nemotron-ultra-253b-v1
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=nvapi-YOUR-NVIDIA-KEY-HERE

# --- Agent API Auth (how benchmark runner connects) ---
AGENT_API_KEY=your-agent-api-key-here
AGENT_PORT=8002
